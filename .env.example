# Copy to .env and fill values locally. Do not commit .env or share secret values.
SUPABASE_URL=https://mgzijfbtrhktxlwjnvdp.supabase.co
# From Supabase Project Settings > API Keys: publishable/anon key, not the database password.
SUPABASE_ANON_KEY=
AUTH_REQUIRED=false
# For PostgreSQL CLI/direct database checks only; the app uses Supabase Auth/REST.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.mgzijfbtrhktxlwjnvdp.supabase.co:5432/postgres
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://mgzijfbtrhktxlwjnvdp.supabase.co
# Paste the same publishable/anon key here for browser sign-in.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
